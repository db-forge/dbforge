# SHARED FILE — owned jointly by all three developers.
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Developer 3) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Monad Testnet (Developer 2) — see lib/monad/README.md ---
# Public (client-side wagmi config); server falls back to these if the
# MONAD_-prefixed vars below are unset.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143

# Server-only — the settlement adapter (lib/monad). Never NEXT_PUBLIC_.
MONAD_RPC_URL=
MONAD_CHAIN_ID=
# MissionVault (required for settlement/withdrawal).
MONAD_VAULT_ADDRESS=
# First block to scan for Vault Settled/Withdrawn logs (its deploy block).
MONAD_VAULT_DEPLOY_BLOCK=
# ProvenanceRegistry (required for dataset anchor/read helpers only).
MONAD_REGISTRY_ADDRESS=
# MissionFactory (required for readMissionCreated only).
MONAD_FACTORY_ADDRESS=
# Verifier hot wallet private key (VERIFIER_ROLE). NEVER logged/returned/committed.
MONAD_VERIFIER_PRIVATE_KEY=
# Optional tuning — see lib/monad/README.md for defaults.
MONAD_TX_TIMEOUT_MS=
MONAD_TX_CONFIRMATIONS=
MONAD_POLL_INTERVAL_MS=
MONAD_LEASE_MS=
MONAD_DROP_GRACE_MS=
MONAD_LOG_CHUNK_BLOCKS=

# --- Verification (Developer 3) ---
VERIFICATION_API_KEY=

# --- AI verification (Developer 3, M3) ---
# Vision provider for POST /api/verify/[submissionId]/ai. Server-only —
# never exposed client-side.
OPENAI_API_KEY=
# Optional override; defaults to gpt-4o-mini if unset.
OPENAI_VISION_MODEL=
# Demo events only: technical-pass submissions are accepted even if vision
# verification is unavailable or ambiguous. Keep unset/false in real operation.
DEMO_AUTO_APPROVE_SUBMISSIONS=
